[Unit]
Description=Rozzgaar Chatbot (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ec2-user/rozzgaar-chatbot
ExecStart=/usr/bin/docker compose up -d --build
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target

# Install:
#   sudo cp deploy/rozzgaar-chatbot.service /etc/systemd/system/
#   # edit WorkingDirectory above if your user/path differs (ubuntu users:
#   # /home/ubuntu/rozzgaar-chatbot)
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rozzgaar-chatbot
#   sudo systemctl status rozzgaar-chatbot
