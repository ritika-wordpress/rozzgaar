# Copy to .env for local dev. In AWS, set these as environment variables /
# secrets on the service instead (App Runner env vars, ECS task def
# secrets, or Elastic Beanstalk configuration) - never bake them into git
# or the Docker image.

# Rozzgaar public API
ROZZGAAR_BASE_URL=https://rozzgaar.in/apis
ROZZGAAR_OPEN_KEY=replace_me

# Static pages to scrape for extra knowledge (About, FAQ, etc.) - comma separated
STATIC_PAGE_URLS=https://rozzgaar.in/,https://rozzgaar.in/courses,https://rozzgaar.in/about,https://rozzgaar.in/contact,https://rozzgaar.in/verify,https://rozzgaar.in/privacy-policy,https://rozzgaar.in/terms,https://rozzgaar.in/refund-policy

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=replace_me
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Secret required in the "X-Admin-Secret" header to trigger a knowledge-base refresh
ADMIN_SECRET=replace_me_with_a_strong_random_value

# Comma separated list of origins allowed to call this API from the browser
# (your production frontend domain(s) - do NOT leave this as * in prod)
ALLOWED_ORIGINS=https://rozzgaar.in

# Public URL where THIS backend is reachable once deployed (App Runner /
# ALB / CloudFront URL, or your own custom domain). Injected into
# static/embed.js's CONFIG.BACKEND_URL.
PUBLIC_BACKEND_URL=https://replace-with-your-aws-url

# Where the built knowledge base + cached content is stored on disk
DATA_DIR=./data
